{
    "name": "@expense-bot/keycloak-theme",
    "version": "0.0.0",
    "description": "Keycloak login and email themes (Keycloakify)",
    "type": "module",
    "scripts": {
        "postinstall": "keycloakify sync-extensions",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "pnpm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "lint": "eslint ."
    },
    "dependencies": {
        "@expense-bot/ui": "workspace:*",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@keycloakify/email-native": "~260007.0.0",
        "keycloakify": "^11.16.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@storybook/react": "^8.1.10",
        "@storybook/react-vite": "^8.1.10",
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "storybook": "^8.1.10",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8"
    },
    "private": true
}
